APP_NAME="ONDRAWEB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL musí v produkci/stagingu obsahovat https:// (např. https://ondraweb.cz),
# jinak se generují absolutní URL (sitemap, canonical, redirecty) přes http://.
APP_URL="http://localhost:8000"

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Filament admin (single-admin login)
# Pouzite v config/admin.php a AdminUserSeeder.
# AdminUserSeeder bezi pouze mimo local/testing prostredi.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Vlastní URL pro admin panel — bez úvodního lomítka. Default: admin-cms.
# Skrývá fakt, že běží Filament, a ztěžuje plošné enumeration útoky.
FILAMENT_ADMIN_PATH=admin-cms

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itwebtech_v3
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# V produkci nech prázdné — config/session.php se přepne na true automaticky
# při APP_ENV=production. Lokálně (http) musí zůstat prázdné/false.
SESSION_SECURE_COOKIE=

# Security headers (bepsvpt/secure-headers). HSTS se aktivuje automaticky
# při APP_ENV=production; tady jde explicitně přepnout (např. staging na http).
# SECURE_HEADERS_HSTS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.seznam.cz
# OND-264: 465 ani 25 z produkčního hostu neprojdou (timeout), otevřený je
# jen 587 se STARTTLS. Na 465 notifikace z formulářů tiše nedorazí.
MAIL_PORT=587
MAIL_USERNAME="xxx"
MAIL_PASSWORD="xxx"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="xxx"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO=ok@ondraweb.cz
CONTACT_PHONE=+420 728 697 712
LANDING_DOMAIN=
LANDING_PREVIEW_PATH=lp/webove-stranky-na-miru

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# twill
ADMIN_APP_PATH=/admin-cms
MEDIA_LIBRARY_ENDPOINT_TYPE=local
MEDIA_LIBRARY_LOCAL_PATH=uploads/media
FILE_LIBRARY_ENDPOINT_TYPE=local
FILE_LIBRARY_LOCAL_PATH=uploads/files
FILE_LIBRARY_FILESIZE_LIMIT=100

#Google Analytics
GOOGLE_ANALYTICS_ID=G-TLQ4403LSS

# Consultation modal
# CALENDLY_URL — URL of the Calendly event with pre-configured questions:
#   "Co řešíte?" + "Odhadovaný rozpočet?" (configure in Calendly admin → Event types → Questions)
CALENDLY_URL=
# CONSULTATION_VIDEO_URL — public URL or path to the consultation MP4 video
#   Example: /videos/consultation.mp4 (place file in public/videos/)
CONSULTATION_VIDEO_URL=

# Feature flags
# SHOW_PORTFOLIO_SECTION — zapnout sekci „Realizované projekty" na homepage.
# Per OND-120: souhlasy 3 klientů (PitArena, BARANA, Nové interiéry) přijaté
# v OND-117. Na staging/produkci nastavit na true (Coolify/Forge env).
SHOW_PORTFOLIO_SECTION=true
# SHOW_TOYOTA_TESTIMONIAL — zapnout testimonial Pavla Baudyše (Toyota) na pozici 1.
# Per OND-114: Ondřej potvrdil souhlas s publikací. Na staging/produkci nastavit na true.
SHOW_TOYOTA_TESTIMONIAL=true

# Booking widget (Reservanto) — sekundární CTA na homepage
SITE_BOOKING_ENABLED=true
SITE_BOOKING_PROVIDER=reservanto
SITE_BOOKING_WIDGET_ID=20854
SITE_BOOKING_RESOURCE_ID=32112
SITE_BOOKING_CTA_TEXT="15 min. konzultace ZDARMA"

# ─── Analytics (OND-122, plán §9) ───────────────────────────────────────────
# Master vypínač — nech `false` na stagingu, aby se neredukovaly produkční
# metriky testovacími klikáními. Na produkci `true`.
ANALYTICS_ENABLED=false

# Plausible — preferované (GDPR-friendly, bez cookie banneru).
# Zaregistruj doménu na plausible.io a vyplň přesně tak, jak je v Plausible
# (např. „ondraweb.cz" bez https:// a bez slash).
PLAUSIBLE_DOMAIN=
# Volitelně přepsat URL skriptu (např. self-hosted, jiná tagged-events varianta).
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.tagged-events.js

# GA4 — fallback / paralelní měření. Pokud je vyplněn `GA4_MEASUREMENT_ID`,
# použije se; jinak fallback na legacy `GOOGLE_ANALYTICS_ID` výše.
GA4_MEASUREMENT_ID=

# Microsoft Clarity — heatmapy + session recordings (zdarma).
# Project ID najdeš v clarity.microsoft.com → Settings → Setup → Tracking code.
CLARITY_PROJECT_ID=
# Killswitch (OND-123 iter3): nastavit na `false` pokud Clarity tlačí PSI mobile
# Performance dolů (YouTube preconnect + tracking pixely), i když je project_id
# vyplněné. Default `true` = standardní chování s project_id.
CLARITY_ENABLED=true
