<IfModule mod_expires.c>
    ExpiresActive On
    # výchozí TTL = 1 měsíc
    ExpiresDefault "access plus 1 month"

    # konkrétní MIME‐typeny
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType application/json        "access plus 0 seconds"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/avif              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # nechceme cacheovat JSON apod., proto výjimky níže
    <FilesMatch "\.(?:css|js|woff2?|webp|avif|svg)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:json)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^www.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]   
    
    RewriteCond %{HTTP_HOST} ^ycf-cup.cz$ [OR]
    RewriteCond %{HTTP_HOST} ^www.ycf-cup.cz$
    RewriteRule (.*)$ http://pitarena.cz/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    #temporary redirect
    Redirect 302 /startovne https://pitarena.cz/cup/registrace-cup
    Redirect 302 /kalendar-zavodu https://pitarena.cz/cup/kalendar
    Redirect 302 /motocykly https://pitarena.cz/cup/kategorie
    Redirect 302 /registrace https://pitarena.cz/cup/registrace-cup
    Redirect 302 /pravidla https://pitarena.cz/cup/pravidla
    Redirect 302 /zavodnici https://pitarena.cz/cup
    Redirect 302 /sponzori https://pitarena.cz/cup
    Redirect 302 /galerie https://pitarena.cz/gallery
    Redirect 302 /kontakt https://pitarena.cz/o-nas
    Redirect 302 /pravidla-ochrany-soukromi https://pitarena.cz/o-nas
    #Redirect 302 /obchodni-podminky https://pitarena.cz/o-nas

    #permanent redirect
    Redirect 301 /kalendar https://pitarena.cz/cup/kalendar
    Redirect 301 /kategorie https://pitarena.cz/cup/kategorie
    Redirect 301 /pravidla https://pitarena.cz/cup/pravidla
    Redirect 301 /registrace-cup https://pitarena.cz/cup/registrace-cup
    Redirect 301 /objednavka-cup https://pitarena.cz/cup/objednavka-cup
    Redirect 301 /vysledky https://pitarena.cz/cup/vysledky
    Redirect 301 /akademie/mx-solo https://pitarena.cz/poukazy/mx-solo
    Redirect 301 /akademie/mx-go https://pitarena.cz/poukazy/mx-go
    Redirect 301 /akademie/mx-hobby https://pitarena.cz/poukazy/mx-hobby
    Redirect 301 /prodej-pitbike/BIGY_150E_MX https://pitarena.cz/prodej-pitbike/BIGY_150E_XL

</IfModule>
